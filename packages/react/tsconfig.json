{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "baseUrl": "../..",
    "paths": {
      "@repo/ui/*": ["../../ui/src/*"],
      "veluy/*":["packages/veluy/src/*"],
      "@veluy/shared":["packages/shared/src/*"],
      "@/*": ["packages/react/src/*"],
    },
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
