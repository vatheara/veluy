{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "baseUrl": "src",
    "paths": {
      "@/*": ["./*"],
      "@repo/ui/*": ["../../ui/src/*"]
    },
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
