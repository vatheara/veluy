{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "./base.build.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "paths": {
      "@veluy/shared": ["packages/shared/src"],
      "@veluy/react": ["packages/react/src"],
      "@veluy/react/*": ["packages/react/src/*"],
      "veluy/*": ["packages/veluy/src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages":["effect"]
      }
    ]
  }
}
